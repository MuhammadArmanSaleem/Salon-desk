    "setup:owner": "node --env-file=.env.local scripts/bootstrap-owner.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "lucide-react": "^0.468.0",
